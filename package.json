{
	"name": "@snowdrive/utils",
	"version": "1.0.2",
	"author": "Luciano Morales",
	"license": "MIT",
	"description": "Colección de utilidades reutilizables desarrolladas en TypeScript.",
	"publishConfig": {
		"access": "public",
		"tag": "latest"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/luc-mo/utils.git"
	},
	"files": [
		"dist"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsup",
		"lint": "biome check . --write",
		"format": "biome format --write .",
		"lint:check": "biome check .",
		"format:check": "biome format ."
	},
	"peerDependencies": {
		"cors": "^2.0.0",
		"express": "^4.0.0 || ^5.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.11",
		"@snowdrive/biome-config": "1.4.0",
		"@types/cors": "2.8.19",
		"@types/express": "5.0.6",
		"@types/node": "25.3.2",
		"cors": "2.8.6",
		"express": "5.2.1",
		"tsup": "8.5.1",
		"tsx": "4.21.0",
		"typescript": "5.9.3"
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	}
}
